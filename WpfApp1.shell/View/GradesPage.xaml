<UserControl x:Class="WpfApp1.shell.View.GradesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WpfApp1.shell.ViewModel"
             xmlns:local="clr-namespace:WpfApp1.shell.View"
             mc:Ignorable="d"
             MinWidth="900" MinHeight="600">
    <UserControl.Resources>
        <!-- Стиль для кнопок -->
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#38427C"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="10" 
                                Background="White"
                                BorderBrush="#3A4A9F" 
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Конвертер для переключения видимости -->
        <vm:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель выбора -->
        <StackPanel Grid.Row="1" Background="#5E6BBD" Orientation="Horizontal" Margin="10,0,0,0">
            <Border Background="White" 
                CornerRadius="8" 
                Padding="12,5" Height="30" Margin="15,0,0,0"
    >
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                </Border.Effect>
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#38427C" Margin="0,-5,0,0"><Run Language="ru-ru" Text="Оценки"/></TextBlock>
            </Border>
            <TextBlock Text="Четверть:" FontSize="16" FontWeight="Bold" Foreground="White" Margin="10" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Quarters}" 
                     SelectedItem="{Binding SelectedQuarter}"
                     DisplayMemberPath="Name"
                     Width="131" Margin="8"
                     VerticalAlignment="Center"/>

            <TextBlock Text="Предмет:" FontSize="16" FontWeight="Bold" Foreground="White" Margin="10" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Subjects}" 
                     SelectedItem="{Binding SelectedSubject}"
                     DisplayMemberPath="Name"
                     Width="145" Margin="8"
                     VerticalAlignment="Center"/>

            <Button Content="   Обновить   " Command="{Binding RefreshCommand}" Margin="8" Padding="10,5" Style="{StaticResource CustomButtonStyle}"/>
            <Button Content="   Сохранить все   " Command="{Binding SaveAllCommand}" Margin="8" Padding="10,5" Style="{StaticResource CustomButtonStyle}"/>
            <Button Content="   Средняя оценка   " Command="{Binding CalculateAverageCommand}" Margin="8" Padding="10,5" Style="{StaticResource CustomButtonStyle}"/>
        </StackPanel>

        <!-- Таблица оценок -->
        <ScrollViewer Grid.Row="2" Margin="10,0,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пустая ячейка (скрыта в режиме средних) -->
                <Border Grid.Row="0" Grid.Column="0" Width="200" Height="40" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0"
                        Visibility="{Binding IsAverageMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}"/>

                <!-- Шапка с датами (скрыта в режиме средних) -->
                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Dates}"
                             Visibility="{Binding IsAverageMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="100" Height="40" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0">
                                <TextBlock Text="{Binding DateValue, StringFormat={}{0:dd.MM}}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Шапка "Средняя оценка" (видна только в режиме средних) -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Visibility="{Binding IsAverageMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                       
                        <Border Width="100" Height="40" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0" HorizontalAlignment="Left" Margin="200,0,0,0">
                            <TextBlock Text="Средняя оценка" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Список студентов -->
                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding StudentGradesRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="40" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0">
                                <TextBlock Text="{Binding StudentName}" 
                                          Margin="10,0" VerticalAlignment="Center"
                                          FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Оценки по датам (скрыты в режиме средних) -->
                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding StudentGradesRows}"
                             Visibility="{Binding IsAverageMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Grades}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="100" Height="40" BorderBrush="Gray" BorderThickness="1">
                                            <TextBox Text="{Binding Grade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="14"
                                                     FontWeight="Bold"
                                                     HorizontalAlignment="Center" 
                                                     VerticalAlignment="Center"
                                                     PreviewTextInput="TextBox_PreviewTextInput"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Средние оценки (видны только в режиме средних) -->
                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding StudentGradesRows}"
                             Visibility="{Binding IsAverageMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Width="100" Height="40" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding AverageGrade}" 
                                               FontSize="14"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>