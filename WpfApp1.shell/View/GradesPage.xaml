<Window x:Class="WpfApp1.shell.View.GradesPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.shell.View"
        mc:Ignorable="d"
        Title="Оценки" Height="600" Width="900" MinWidth="900" MinHeight="600">
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Верхняя полоска -->
                <RowDefinition Height="*"/>
                <!-- Основная область -->
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <!-- Левая панель -->
                <ColumnDefinition Width="*"/>
                <!-- Основная область -->
            </Grid.ColumnDefinitions>

            <!-- Верхняя полоска -->
            <Border Background="#7685E5" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Username}" 
                       Background="White"
                       FontSize="16" 
                       Foreground="Black" 
                       RenderTransformOrigin="0.5,0.5" Width="130" Height="22">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="-1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>

            </StackPanel>


            </Border>
            <Border Background="#38427C" Margin="150,40,0,0" Grid.ColumnSpan="2" Grid.RowSpan="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Border>

            <!-- Левая панель с кнопками -->
            <Border Background="#7685E5" Grid.Column="0" Margin="0,40,67,0" Grid.RowSpan="2">
                <StackPanel VerticalAlignment="Top">
                    <Button Content="Расписание" Margin="10" Click="ScheduleButton_Click"/>
                    <Button Content="Оценки" Margin="10" Click="GradesButton_Click"/>
                    <Button Content="Школа" Margin="10" Click="SchoolButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Основная область с заголовком и текстом -->
            <Border Background="White" Grid.Row="1" Grid.ColumnSpan="2" Margin="150,10,0,0">
            </Border>


            <Border Background="#38427C" Margin="133,40,50,0" Grid.RowSpan="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Border>
        </Grid>
</Window>
