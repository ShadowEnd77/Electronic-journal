<UserControl x:Class="WpfApp1.shell.View.GradesPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.shell.View"
        mc:Ignorable="d"
        MinWidth="900" MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Основное содержимое -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="    Тут будет выборка параметров выпадающими списками по оценкам"
               FontSize="20"
               FontWeight="Bold"
               Background="#5E6BBD"
               TextAlignment="Left"
               Margin="0,0,0,0" 
               VerticalAlignment="Top"/>

        <!-- Основное содержимое с белым фоном и отступом слева -->
        <Border Grid.Row="1" Background="White" Margin="10,0,0,0">
            <!-- Отступ слева 10 -->
            <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                <TextBlock Text="Тут будет находиться выборка с предметами и калссами" 
                       VerticalAlignment="Top" 
                       Margin="10"/>
                <!-- Здесь можно добавить другие элементы управления, например, DataGrid для таблицы -->
                <DataGrid Name="ScheduleDataGrid" 
                      AutoGenerateColumns="True" 
                      Margin="10"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>