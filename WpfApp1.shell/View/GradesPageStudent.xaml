<UserControl x:Class="WpfApp1.shell.View.GradesPageStudent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WpfApp1.shell.View"
             mc:Ignorable="d"
             MinWidth="900" MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель выбора четверти -->
        <StackPanel Grid.Row="1" Background="#5E6BBD" Orientation="Horizontal" Margin="10,0,0,0">
            <Border Background="White" 
                CornerRadius="8" 
                Padding="12,5" Height="30" Margin="15,0,0,0"
    >
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                </Border.Effect>
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#5E6BBD" Margin="0,-5,0,0"><Run Language="ru-ru" Text="Оценки"/></TextBlock>
            </Border>
            <TextBlock Text="Четверть:" FontSize="16" FontWeight="Bold" Foreground="White" Margin="10" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Quarters}" 
                     SelectedItem="{Binding SelectedQuarter}"
                     DisplayMemberPath="Name"
                     Width="154" Margin="8"
                     VerticalAlignment="Center"/>
            <!-- Закругленная кнопка Обновить -->
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="10" Padding="10,5" Height="24" Width="78" Foreground="#38427C">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                CornerRadius="10" 
                                Background="White"
                                BorderBrush="#3A4A9F" 
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Text="Поиск по дате:"
                Foreground="White"
                FontSize="16" Height="26"/>
            <TextBox Text="{Binding SearchDate, UpdateSourceTrigger=PropertyChanged}" 
                Width="150" 
                Padding="5"
                ToolTip="Формат: ДД.ММ.ГГГГ или ДД.ММ" Height="27" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button Content="Итоговые" Command="{Binding ShowAveragesCommand}" Padding="10,5" Height="24" Width="78" Foreground="#38427C" Margin="10,0,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                    CornerRadius="10" 
                    Background="White"
                    BorderBrush="#3A4A9F" 
                    BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Матрица оценок -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пустая ячейка в углу -->
                <Border Grid.Row="0" Grid.Column="0" MinWidth="120" Height="40" 
                        BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0" Margin="10,0,0,0"/>

                <!-- Шапка с предметами -->
                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Subjects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="120" Height="40" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0">
                                <TextBlock Text="{Binding Name}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          FontWeight="Bold" ToolTip="{Binding Name}"
                                          TextWrapping="Wrap" TextAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Список дат -->
                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Dates}" Margin="10,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="120" Height="40" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0" >
                                <TextBlock Text="{Binding Date.DateValue, StringFormat={}{0:dd.MM.yyyy}}" 
                                           Margin="20,0" VerticalAlignment="Center"
                                           FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Оценки -->
                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Dates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding GradesForDate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinWidth="120" Height="40" BorderBrush="Gray" BorderThickness="1">
                                            <TextBlock Text="{Binding}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      FontSize="14" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>