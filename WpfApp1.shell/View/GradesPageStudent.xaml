<UserControl x:Class="WpfApp1.shell.View.GradesPageStudent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WpfApp1.shell.View"
             mc:Ignorable="d"
             MinWidth="900" MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель выбора четверти -->
        <StackPanel Grid.Row="1" Background="#5E6BBD" Orientation="Horizontal" Margin="10,0,0,0">
            <TextBlock Text="Четверть:" FontSize="16" FontWeight="Bold" Foreground="White" Margin="10" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Quarters}" 
                     SelectedItem="{Binding SelectedQuarter}"
                     DisplayMemberPath="Name"
                     Width="200" Margin="8"
                     VerticalAlignment="Center"/>
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="10" Padding="10,5"/>
        </StackPanel>

        <!-- Матрица оценок -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пустая ячейка в углу -->
                <Border Grid.Row="0" Grid.Column="0" MinWidth="120" Height="40" 
                        BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0" Margin="10,0,0,0"/>

                <!-- Шапка с предметами -->
                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Subjects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="120" Height="40" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0">
                                <TextBlock Text="{Binding Name}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          FontWeight="Bold" ToolTip="{Binding Name}"
                                          TextWrapping="Wrap" TextAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Список дат -->
                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Dates}" Margin="10,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="120" Height="40" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0" >
                                <TextBlock Text="{Binding Date.DateValue, StringFormat={}{0:dd.MM.yyyy}}" 
                                           Margin="20,0" VerticalAlignment="Center"
                                           FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Оценки -->
                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Dates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding GradesForDate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinWidth="120" Height="40" BorderBrush="Gray" BorderThickness="1">
                                            <TextBlock Text="{Binding}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      FontSize="14" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>