<Window x:Class="WpfApp1.shell.View.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="900" MinWidth="900" MinHeight="600">

    <Grid Background="#D9D9D9">
        <Border Background="#7685E5" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="184">
            <StackPanel>
                <TextBlock Text="Логин:" Foreground="#D9D9D9" Margin="0,0,0,5"/>
                <Border CornerRadius="5" BorderBrush="#7685E5" BorderThickness="1" Margin="0,0,0,10">
                    <TextBox Text="{Binding Username}" Background="#D9D9D9"/>
                </Border>

                <TextBlock Text="Пароль:" Foreground="#D9D9D9" Margin="0,0,0,5"/>
                <Border CornerRadius="50" BorderBrush="#7685E5" BorderThickness="1" Margin="0,0,0,10">
                    <PasswordBox x:Name="PasswordBox" Background="#D9D9D9"/>
                </Border>

                <Button Content="Войти" Command="{Binding LoginCommand}" Background="#D9D9D9" Foreground="#7685E5" Click="LoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>