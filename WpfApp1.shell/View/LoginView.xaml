<Window x:Class="WpfApp1.shell.View.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="700" Width="1000" MinWidth="900" MinHeight="600"
        Title="Вход" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Стиль для закругленных кнопок -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Foreground" Value="#7685E5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C0C0C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#D9D9D9">
        <Border Background="#7685E5" CornerRadius="10" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
            <StackPanel>
                <TextBlock Text="Логин:" Foreground="#D9D9D9" Margin="0,0,0,8" FontSize="16"/>
                <Border CornerRadius="5" BorderBrush="#7685E5" BorderThickness="1" Margin="0,0,0,15" Background="#D9D9D9">
                    <TextBox Text="{Binding Username}" Background="#D9D9D9" FontSize="16" Padding="8"/>
                </Border>

                <TextBlock Text="Пароль:" Foreground="#D9D9D9" Margin="0,0,0,8" FontSize="16"/>
                <Border CornerRadius="15" BorderBrush="#7685E5" BorderThickness="1" Margin="0,0,0,20" Background="#D9D9D9">
                    <PasswordBox x:Name="PasswordBox" Background="#D9D9D9" FontSize="16" Padding="8"/>
                </Border>

                <Button Content="Войти" Command="{Binding LoginCommand}" Style="{StaticResource RoundedButton}" Click="LoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>