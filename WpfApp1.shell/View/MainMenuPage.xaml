<UserControl x:Class="WpfApp1.shell.View.MainMenuPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d"
        MinWidth="900" MinHeight="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Основная область -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Основная область с заголовком и текстом -->
        <Border Background="#FFFFFF" Margin="20,0,0,0">
            <Viewbox Stretch="Uniform">
                <Grid>
                    <!-- Определяем строки и столбцы для основного контента -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Заголовок -->
                        <RowDefinition Height="*"/>
                        <!-- Основное содержимое -->
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="293"/>
                        <!-- Левая колонка для изображения -->
                        <ColumnDefinition/>
                        <!-- Центральная колонка для текста -->
                        <ColumnDefinition Width="217"/>
                        <!-- Правая колонка для текста -->
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Text="Муниципальное общеобразовательное учреждение: Лицей №32"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#38427C"
                               TextAlignment="Left"
                               Grid.ColumnSpan="3"
                               Margin="0,10,0,10"/>

                    <!-- Изображение в левой колонке -->
                    <Border Grid.Row="1" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top" 
                        Height="403" 
                        Margin="10,15,10,10" 
                        Width="272">    
                        <!-- Внешний Border для рамки -->
                        <Border BorderBrush="#5E6BBD" 
                            BorderThickness="3"
                            CornerRadius="0"
                            ClipToBounds="True">    
                            <!-- Внутренний Border для скругления изображения -->
                            <Border CornerRadius="30" ClipToBounds="True">
                                <Image Source="/View/school.jpg" Stretch="UniformToFill"/>
                            </Border>
                        </Border>
                    </Border>

                    <!-- Центральный текст в средней колонке -->
                    <TextBlock
                               FontSize="16"
                               Foreground="#000000"
                               TextAlignment="Left"
                               Margin= "0,10,10,63"
                               Grid.Column= "1" 
                               RenderTransformOrigin="0.5,0.5" 
                               Grid.Row="1" 
                               HorizontalAlignment="Right" 
                               Width="218">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleY="1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                        <Run Text="Адрес организации:"/><LineBreak/>
                        <Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/><Run/><LineBreak/>
                        <Run Text="Телефон организации:"/><LineBreak/>
                        <Run/><LineBreak/>
                        <Run Text="E-mail Организации:"/><LineBreak/>
                        <Run/><LineBreak/>
                        <Run Text="Адрес сайта:"/><LineBreak/>
                        <Run/><LineBreak/>
                        <Run Text="Количество сотрудников:"/><LineBreak/>
                        <Run/><LineBreak/>
                        <Run Text="Количество учеников"/>
                    </TextBlock>

                    <!-- Текст в правой колонке -->
                    <TextBlock
                               FontSize= "16"
                               Foreground= "#000000"
                               TextAlignment= "Left"
                               Margin= "10,10,0,51"
                               Grid.Column= "2" 
                               RenderTransformOrigin="0.5,0.5" 
                               Grid.Row="1" 
                               HorizontalAlignment="Left" 
                               Width="197">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleY="1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                        <Run Text=" 160031, Вологодская "/><LineBreak/>
                        <Run Text="область, городской округ "/><LineBreak/>
                        <Run Text="город Вологда, "/><LineBreak/>
                        <Run Text="город Вологда, улица "/><LineBreak/>
                        <Run Text="Кирова, д.35"/><LineBreak/><Run/><LineBreak/>
                        <Run Text="72-43-32"/><LineBreak/><Run/><LineBreak/>
                        <Run Text="school32@vologda.edu.ru"/><LineBreak/><Run/><LineBreak/>
                        <Run Text="http://lyc32.edu35.ru"/><LineBreak/><Run/><LineBreak/>
                        <Run Text="60"/><LineBreak/><Run/><LineBreak/>
                        <Run Text="906"/>
                    </TextBlock>
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>