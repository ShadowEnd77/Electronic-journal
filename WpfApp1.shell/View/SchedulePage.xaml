<UserControl x:Class="WpfApp1.shell.View.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.shell.View"
             xmlns:model="clr-namespace:WpfApp1.shell.Model"
             MinWidth="900" MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Background="#5E6BBD" Margin="0,0,0,10" Padding="15">
            <Border Background="White" CornerRadius="8" Padding="12,5"
                    HorizontalAlignment="Left" VerticalAlignment="Center" 
                    Margin="15,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                </Border.Effect>
                <TextBlock Text="Расписание преподавателя"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#5E6BBD"/>
            </Border>
        </Border>

        <!-- Выбор четверти -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Четверть:" VerticalAlignment="Center" Margin="10,0,10,0"/>
            <ComboBox ItemsSource="{Binding Quarters}"
                      SelectedItem="{Binding SelectedQuarter}"
                      DisplayMemberPath="Name"
                      Width="200"/>
        </StackPanel>

        <!-- Основное содержимое -->
        <Border Grid.Row="2" Background="White" Margin="10">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding ScheduleDays}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Margin="10,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding DayOfWeek, StringFormat={}{0}:}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,5"/>

                                    <TextBlock Text="{Binding Date, StringFormat={}Дата: {0:dd.MM.yyyy}}"
                                               FontSize="14"
                                               Margin="0,0,0,10"/>

                                    <ItemsControl ItemsSource="{Binding Subjects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#EEE" BorderThickness="1" 
                                                        CornerRadius="4" Margin="0,0,0,5" Padding="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding SubjectName}" 
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ClassName}" 
                                                                       Foreground="#555"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>