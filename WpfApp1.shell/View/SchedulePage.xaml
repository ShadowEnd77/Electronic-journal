<UserControl x:Class="WpfApp1.shell.View.SchedulePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="900" MinWidth="900" MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Основная область с заголовком и текстом -->
        <Border Background="White" Margin="20,0,0,0">
            <Grid Margin="10,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <!-- Определяем строки для основного контента -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="16.6"/>
                    <!-- Заголовок и изображение -->
                    <RowDefinition/>
                    <!-- Основное содержимое -->
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Text="Тут будет выборка параметров выпадающими списками по расписанию"
                FontSize="20"
                FontWeight="Bold"
                Background="#5E6BBD"
                TextAlignment="Left"
                Margin="-10,-20,0,10"/>
                <!-- Текстовая информация во второй строке -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Height="476" VerticalAlignment="Top" Margin="-10,10,0,0">
                    <TextBlock Text="Тут надо будет вставлять таблицу" Height="476" Width="740"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>